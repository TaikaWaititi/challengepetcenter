{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "name": "nsg-petcenter-oracle",
      "apiVersion": "2023-11-01",
      "location": "brazilsouth",
      "properties": {
        "securityRules": [
          {
            "name": "OracleFromWebApp",
            "properties": {
              "priority": 100,
              "direction": "Inbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "1521",
              "sourceAddressPrefix": "10.42.2.0/26",
              "destinationAddressPrefix": "10.42.1.4"
            }
          },
          {
            "name": "DenyOtherInbound",
            "properties": {
              "priority": 1000,
              "direction": "Inbound",
              "access": "Deny",
              "protocol": "*",
              "sourcePortRange": "*",
              "destinationPortRange": "*",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "name": "vnet-petcenter-sprint4",
      "apiVersion": "2023-11-01",
      "location": "brazilsouth",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.42.0.0/16"
          ]
        },
        "subnets": [
          {
            "name": "oracle",
            "properties": {
              "addressPrefix": "10.42.1.0/24",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups','nsg-petcenter-oracle')]"
              }
            }
          },
          {
            "name": "webapp",
            "properties": {
              "addressPrefix": "10.42.2.0/26",
              "delegations": [
                {
                  "name": "webapp",
                  "properties": {
                    "serviceName": "Microsoft.Web/serverFarms"
                  }
                }
              ]
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups','nsg-petcenter-oracle')]"
      ]
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "name": "pip-petcenter-oracle-outbound",
      "apiVersion": "2023-11-01",
      "location": "brazilsouth",
      "properties": {
        "publicIPAllocationMethod": "Static"
      },
      "sku": {
        "name": "Standard"
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "name": "nic-petcenter-oracle",
      "apiVersion": "2023-11-01",
      "location": "brazilsouth",
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "privateIPAllocationMethod": "Static",
              "privateIPAddress": "10.42.1.4",
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets','vnet-petcenter-sprint4','oracle')]"
              },
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses','pip-petcenter-oracle-outbound')]"
              }
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks','vnet-petcenter-sprint4')]",
        "[resourceId('Microsoft.Network/publicIPAddresses','pip-petcenter-oracle-outbound')]"
      ]
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "name": "vm-petcenter-oracle",
      "apiVersion": "2024-03-01",
      "location": "brazilsouth",
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('vmSize')]"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "ubuntu-24_04-lts",
            "sku": "server",
            "version": "latest"
          },
          "osDisk": {
            "createOption": "FromImage",
            "diskSizeGB": 64,
            "managedDisk": {
              "storageAccountType": "StandardSSD_LRS"
            }
          },
          "dataDisks": [
            {
              "lun": 0,
              "name": "disk-petcenter-oracle-data",
              "diskSizeGB": 32,
              "createOption": "Empty",
              "managedDisk": {
                "storageAccountType": "StandardSSD_LRS"
              }
            }
          ]
        },
        "osProfile": {
          "computerName": "petcenter-oracle",
          "adminUsername": "petcenteradmin",
          "customData": "[base64(parameters('cloudInit'))]",
          "linuxConfiguration": {
            "disablePasswordAuthentication": true,
            "ssh": {
              "publicKeys": [
                {
                  "path": "/home/petcenteradmin/.ssh/authorized_keys",
                  "keyData": "[parameters('sshPublicKey')]"
                }
              ]
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces','nic-petcenter-oracle')]"
            }
          ]
        },
        "diagnosticsProfile": {
          "bootDiagnostics": {
            "enabled": true
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces','nic-petcenter-oracle')]"
      ]
    }
  ],
  "parameters": {
    "sshPublicKey": {
      "type": "string"
    },
    "cloudInit": {
      "type": "string"
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_D2s_v3"
    }
  }
}